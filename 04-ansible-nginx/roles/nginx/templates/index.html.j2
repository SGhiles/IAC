<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ nginx_page_title }}</title>
  <style>
    :root {
      --primary: #6366f1;
      --primary-dark: #4f46e5;
      --bg: #f5f7fb;
      --card: #ffffff;
      --text: #1f2937;
      --muted: #6b7280;
      --counter-bg: #eef2ff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: linear-gradient(135deg, #f5f7fb 0%, #e8ecf7 100%);
      color: var(--text);
    }
    .card {
      background: var(--card);
      border-radius: 20px;
      padding: 48px 56px;
      text-align: center;
      box-shadow: 0 10px 40px rgba(99, 102, 241, 0.12), 0 2px 8px rgba(0,0,0,0.04);
      max-width: 480px;
      width: 90%;
    }
    .badge {
      display: inline-block;
      background: var(--counter-bg);
      color: var(--primary-dark);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 6px 14px;
      border-radius: 999px;
      margin-bottom: 20px;
    }
    h1 {
      font-size: 26px;
      font-weight: 700;
      margin: 0 0 8px;
      color: var(--text);
    }
    .subtitle {
      color: var(--muted);
      font-size: 15px;
      margin: 0 0 32px;
      line-height: 1.5;
    }
    button {
      background: var(--primary);
      color: white;
      border: none;
      padding: 14px 36px;
      font-size: 16px;
      font-weight: 600;
      border-radius: 12px;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.1s ease;
      box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
    }
    button:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
    }
    button:active {
      transform: translateY(0);
    }
    .counter-box {
      margin-top: 28px;
      background: var(--counter-bg);
      border-radius: 16px;
      padding: 20px;
    }
    .counter-label {
      font-size: 13px;
      color: var(--primary-dark);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 6px;
    }
    #compteur {
      font-size: 48px;
      font-weight: 800;
      color: var(--primary-dark);
      line-height: 1;
    }
  </style>
</head>
<body>
  <div class="card">
    <span class="badge">Devoir Ansible</span>
    <h1>{{ nginx_page_heading }}</h1>
    <p class="subtitle">Page generee via un template Jinja2 et deployee automatiquement par Ansible.</p>

    <button onclick="incrementer()">Cliquez ici</button>

    <div class="counter-box">
      <div class="counter-label">Compteur de clic</div>
      <div id="compteur">0</div>
    </div>
  </div>

  <script>
    let compte = 0;
    function incrementer() {
      compte++;
      document.getElementById('compteur').innerText = compte;
    }
  </script>
</body>
</html>
